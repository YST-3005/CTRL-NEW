# LabelLens Guardian environment
# Copy to .env.local. Never commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_AUTH_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_FORCE_DEMO_AUTH=true

# Supabase (optional production auth + persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional vision / LLM providers (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_VISION_API_KEY=

# Optional real notification provider (disabled unless explicitly enabled)
NOTIFICATION_PROVIDER=simulation
NOTIFICATION_API_KEY=
